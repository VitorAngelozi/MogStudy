<% content_for :title, "#{@group.name} - MogStudy" %>

<% selected_room_id = @selected_room&.id %>

<div class="container study-group-page">
  <section class="hero subjects-hero study-groups-hero" data-study-group-presence data-presence-url="<%= presence_study_group_path(@group) %>">
    <div>
      <p class="eyebrow">Grupo <%= @group.code %></p>
      <h1><%= @group.name %></h1>
      <p class="lead"><%= @group.description.presence || "Uma comunidade de estudos focada em presenca e constancia." %></p>
      <div class="study-group-hero-stats">
        <span><%= @summary[:members_count] %> membros</span>
        <span data-presence-active-count><%= @summary[:active_count] %> estudando agora</span>
        <span data-presence-seconds-today><%= format_seconds_as_hours(@summary[:seconds_today]) %> hoje</span>
        <span><%= @group.visibility_label %></span>
      </div>
    </div>

    <div class="subjects-hero-actions">
      <%= link_to "Meus grupos", study_groups_path, class: "secondary-button" %>
      <% if @membership.blank? %>
        <%= button_to "Participar", join_study_group_path(@group), method: :post, class: "primary-button" %>
      <% elsif @membership.role != StudyGroupMember::ROLE_OWNER %>
        <%= button_to "Sair do grupo", leave_study_group_path(@group), method: :post, class: "ghost-button" %>
      <% end %>
    </div>
  </section>

  <section class="study-group-layout study-group-server-layout" data-focus-room-workspace>
    <main class="study-group-main">
      <article class="panel focus-room-board">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Salas de foco</p>
            <h2>Escolha onde estudar</h2>
          </div>
        </div>

        <div class="focus-room-grid focus-room-channel-list" role="list">
          <% if @group.focus_rooms.any? %>
            <% @group.focus_rooms.order(:position).each do |room| %>
              <% room_summary = @room_summaries[room.id] || { active_count: room.participations.active.count, seconds_today: 0 } %>
              <% is_studying_room = @active_participation&.study_focus_room_id == room.id %>
              <% is_expanded_room = selected_room_id == room.id %>

              <article class="focus-room-card focus-room-channel <%= "is-muted" unless room.is_active %> <%= "is-expanded" if is_expanded_room %>" data-focus-room-card data-focus-room-id="<%= room.id %>" role="listitem">
                <a href="<%= study_group_path(@group, room: room.id) %>" class="focus-room-channel-link" data-focus-room-select data-focus-room-id="<%= room.id %>">
                  <span class="focus-room-icon"><%= render "shared/icon", name: (room.icon.presence || :book), class: "icon-svg" %></span>
                  <span>
                    <strong><%= room.name %></strong>
                    <small><%= room.description.presence || "Sala para estudos em foco." %></small>
                  </span>
                  <span class="status-pill <%= "status-pill-live" if room.participations.active.any? %>"><%= room.participations.active.count %> agora</span>
                  <span class="focus-room-avatars">
                    <% room.participations.active.limit(5).each do |participation| %>
                      <%= render "shared/user_avatar", user: participation.user, class: "focus-room-avatar" %>
                    <% end %>
                  </span>
                </a>

                <%= button_to "🗑️", "/study-groups/#{@group.code}/focus-rooms/#{room.id}", method: :delete, class: "focus-room-delete-button", form_class: "focus-room-delete-form", title: "Excluir sala" %>

                <div class="focus-room-call" data-focus-room-details <%= "hidden" unless is_expanded_room %>>
                  <div class="focus-room-call-summary">
                    <div>
                      <p class="eyebrow">Canal ativo</p>
                      <h3><%= room.name %></h3>
                    </div>
                    <div class="focus-room-call-pills">
                      <span><%= room_summary[:active_count] %> agora</span>
                      <span><%= format_seconds_as_hours(room_summary[:seconds_today]) %> hoje</span>
                    </div>
                  </div>

                  <section class="focus-room-call-details">
                    <div>
                      <p class="eyebrow">Estudando agora</p>
                      <div class="focus-room-call-people">
                        <% if room.participations.active.any? %>
                          <% room.participations.active.each do |participation| %>
                            <article class="focus-room-person">
                              <%= render "shared/user_avatar", user: participation.user %>
                              <div>
                                <strong><%= participation.user.display_name %></strong>
                                <p><%= participation.study_subject.name %></p>
                                <small data-study-timer data-started-at="<%= participation.started_at.iso8601 %>" data-rendered-at="<%= Time.current.iso8601 %>" data-base-seconds="0" data-elapsed-seconds="<%= participation.effective_elapsed_seconds %>" data-state="<%= participation.paused? ? 'paused' : 'running' %>">
                                  <%= participation.paused? ? "Pausado em" : "Estudando ha" %> <span data-timer-value><%= format_seconds_as_hours(participation.effective_elapsed_seconds) %></span>
                                </small>
                              </div>
                            </article>
                          <% end %>
                        <% else %>
                          <div class="empty-state compact-empty">
                            <strong>Ninguem estudando aqui agora.</strong>
                            <p>Escolha uma materia e de play para aparecer nesta sala.</p>
                          </div>
                        <% end %>
                      </div>
                    </div>

                    <div class="focus-room-call-controls">
                      <p class="eyebrow">Seu foco</p>

                      <% if is_studying_room %>
                        <div class="timer-widget" data-study-timer data-started-at="<%= @active_participation.started_at.iso8601 %>" data-rendered-at="<%= Time.current.iso8601 %>" data-base-seconds="0" data-elapsed-seconds="<%= @active_participation.effective_elapsed_seconds %>" data-state="<%= @active_participation.paused? ? 'paused' : 'running' %>">
                          <div class="timer-subject">
                            <span class="timer-dot"></span>
                            <strong><%= @active_participation.study_subject.name %></strong>
                          </div>
                          <div class="timer-value" data-timer-value><%= format_seconds_as_hours(@active_participation.effective_elapsed_seconds) %></div>
                        </div>

                        <div class="timer-actions stacked-actions">
                          <% if @active_participation.paused? %>
                            <%= button_to "Retomar", resume_study_session_path(@active_participation.study_session), method: :post, class: "secondary-button full-width" %>
                          <% else %>
                            <%= button_to "Pausar", pause_study_session_path(@active_participation.study_session), method: :post, class: "secondary-button full-width" %>
                          <% end %>
                          <%= button_to "Finalizar estudo", "/study-groups/#{@group.code}/focus-rooms/#{room.id}/stop", method: :post, class: "primary-button full-width" %>
                        </div>
                      <% elsif @active_participation.present? %>
                        <div class="empty-state compact-empty">
                          <strong>Voce ja esta estudando em outra sala.</strong>
                          <p>Finalize <%= @active_participation.study_focus_room.name %> antes de iniciar outro foco.</p>
                          <%= link_to "Abrir sala ativa", study_group_path(@active_participation.study_focus_room.study_group, room: @active_participation.study_focus_room.id), class: "secondary-button" %>
                        </div>
                      <% elsif !room.is_active %>
                        <p class="friend-search-state">Essa sala esta arquivada.</p>
                      <% elsif @subjects.blank? %>
                        <div class="empty-state compact-empty">
                          <strong>Crie uma materia primeiro.</strong>
                          <p>As salas usam suas materias pessoais para manter metas e historico corretos.</p>
                          <%= link_to "Criar materia", "#{study_subjects_path}#criar", class: "primary-button full-width" %>
                        </div>
                      <% else %>
                        <%= form_with scope: :focus_session, url: "/study-groups/#{@group.code}/focus-rooms/#{room.id}/start", method: :post, class: "study-room-form", local: true do |form| %>
                          <label class="subject-combobox" data-subject-combobox>
                            <span>Materia pessoal</span>
                            <input type="text" name="focus_session[study_subject_name]" placeholder="Digite para buscar..." autocomplete="off" data-subject-search required>
                            <input type="hidden" name="focus_session[study_subject_id]" data-subject-id>
                            <div class="subject-options" data-subject-options>
                              <% @subjects.each do |subject| %>
                                <button type="button" class="subject-option" data-subject-option data-subject-id="<%= subject.id %>" data-subject-name="<%= subject.name %>">
                                  <%= subject.name %>
                                </button>
                              <% end %>
                            </div>
                          </label>

                          <%= form.text_area :notes, rows: 3, placeholder: "Notas rapidas" %>
                          <%= form.submit "Play / Iniciar estudo", class: "primary-button full-width" %>
                        <% end %>
                      <% end %>
                    </div>
                  </section>
                </div>
              </article>
            <% end %>
          <% else %>
            <div class="empty-state">
              <strong>Nenhuma sala de foco ainda.</strong>
              <p>Administradores podem criar salas como Matematica, Redacao ou Ciencias da Natureza.</p>
            </div>
          <% end %>
        </div>
      </article>

      <% if @can_manage_rooms %>
        <details class="panel focus-admin-details">
          <summary class="focus-admin-summary">
            <div>
              <p class="eyebrow">Administracao</p>
              <h2>Criar sala de foco</h2>
            </div>
            <span class="secondary-button">Nova sala</span>
          </summary>

        <%= form_with scope: :focus_room, url: "/study-groups/#{@group.code}/focus-rooms", method: :post, class: "study-room-form compact-form", local: true do |form| %>
            <label>
              <span>Nome</span>
              <%= form.text_field :name, maxlength: 120, placeholder: "Ex: Ciencias da Natureza", required: true %>
            </label>
            <label>
              <span>Descricao</span>
              <%= form.text_field :description, maxlength: 300, placeholder: "Tema amplo desta sala" %>
            </label>
            <label>
              <span>Icone</span>
              <%= form.select :icon, [["Livro", "book"], ["Alvo", "target"], ["Notas", "notes"], ["Tempo", "clock"]] %>
            </label>
            <%= form.submit "Criar sala", class: "primary-button" %>
          <% end %>
        </details>
      <% end %>
    </main>
  </section>
</div>
