<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <title><%= content_for(:title) || "MogStudy" %></title>
    <script>
      (() => {
        const storedTheme = localStorage.getItem("mogstudy-theme");
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.dataset.theme = storedTheme || (prefersLight ? "light" : "dark");
      })();
    </script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", defer: true %>
  </head>
  <body class="app-shell <%= %w[dashboard profiles].include?(controller_name) ? "app-immersive" : "" %> <%= action_name == "landing" ? "home-page" : "" %>">
    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>

    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Alternar tema" aria-pressed="false">
      <span class="theme-toggle-icon theme-toggle-moon" aria-hidden="true">
        <%= icon_svg(:moon, class_name: "icon-svg") %>
      </span>
      <span class="theme-toggle-icon theme-toggle-sun" aria-hidden="true">
        <%= icon_svg(:sun, class_name: "icon-svg") %>
      </span>
    </button>

    <% unless %w[dashboard profiles].include?(controller_name) %>
      <header class="topbar">
        <div class="container topbar-inner">
          <%= link_to root_path, class: "brand" do %>
            <span class="brand-mark">
              <%= image_tag "branding/mogstudy_cat_main.png", alt: "", aria: { hidden: true } %>
            </span>
            <span>
              <strong>MogStudy</strong>
              <small>GitHub de estudos</small>
            </span>
          <% end %>

          <nav class="topbar-nav">
            <% if authenticated? %>
              <%= link_to "Dashboard", dashboard_path %>
              <%= link_to "Materias", study_subjects_path %>
              <%= link_to "Perfil", profile_path(current_user) %>
              <%= button_to "Sair", logout_path, method: :post, class: "ghost-button", form_class: "inline-form" %>
            <% else %>
              <%= link_to "Entrar", login_path %>
              <%= link_to "Criar conta", register_path, class: "primary-button" %>
            <% end %>
          </nav>
        </div>
      </header>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="flash success flash-fixed"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="flash error flash-fixed">
        <strong>Revise os campos abaixo.</strong>
        <ul>
          <li><%= flash[:alert] %></li>
        </ul>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
