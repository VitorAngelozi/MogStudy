<% content_for :title, "Criar conta - MogStudy" %>

<section class="auth-shell">
  <div class="auth-card">
    <p class="eyebrow">Cadastro</p>
    <h1>Criar conta no MogStudy</h1>

    <%= form_with scope: :auth, url: register_path, method: :post, class: "form-stack" do |form| %>
      <label>
        <span>Username</span>
        <%= form.text_field :username, value: @user&.username, placeholder: "seuusername", required: true %>
      </label>

      <label>
        <span>Nome de exibição</span>
        <%= form.text_field :display_name, value: @user&.display_name, placeholder: "Seu nome" %>
      </label>

      <label>
        <span>E-mail</span>
        <%= form.email_field :email, value: @user&.email, placeholder: "voce@exemplo.com", required: true %>
      </label>

      <label>
        <span>Bio</span>
        <%= form.text_area :bio, value: @user&.bio, rows: 3, maxlength: 500, placeholder: "Conte um pouco sobre sua rotina" %>
      </label>

      <label>
        <span>Senha</span>
        <%= form.password_field :password, placeholder: "Crie uma senha", required: true %>
      </label>

      <label>
        <span>Confirmar senha</span>
        <%= form.password_field :password_confirmation, placeholder: "Repita a senha", required: true %>
      </label>

      <%= form.submit "Criar conta", class: "primary-button full-width" %>
    <% end %>

    <p class="auth-note">
      Já tem uma conta?
      <%= link_to "Entrar", login_path %>
    </p>
  </div>
</section>
